{
  "manifest_version": 3,
  "name": "AfterMeet Capture",
  "version": "0.1.0",
  "description": "Capture people from LinkedIn and the web into AfterMeet.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_title": "Capture to AfterMeet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"]
    }
  ]
}
